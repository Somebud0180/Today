<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "2650"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES"
      buildArchitectures = "Automatic">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "#!/bin/bash&#10;&#10;# Xcode Build Phase Script: Bump Build Number Once Per Commit&#10;# This script runs after a successful build and increments CURRENT_PROJECT_VERSION&#10;# only once before a new commit. It uses git to track the build number bumps.&#10;&#10;set -e&#10;&#10;# Get the project root (Xcode sets PROJECT_DIR)&#10;PROJECT_DIR=&quot;${PROJECT_DIR:-.}&quot;&#10;PROJECT_FILE=&quot;$PROJECT_DIR/project.pbxproj&quot;&#10;&#10;# Ensure we&apos;re in a git repository&#10;if ! git -C &quot;$PROJECT_DIR&quot; rev-parse --git-dir &gt; /dev/null 2&gt;&amp;1; then&#10;    echo &quot;&#x26a0;&#xfe0f;  Not a git repository. Skipping build number bump.&quot;&#10;    exit 0&#10;fi&#10;&#10;# Get the current commit SHA (or HEAD reference if not yet committed)&#10;CURRENT_COMMIT=$(git -C &quot;$PROJECT_DIR&quot; rev-parse HEAD 2&gt;/dev/null || echo &quot;&quot;)&#10;&#10;# Get the current build number from project.pbxproj&#10;get_current_build_number() {&#10;    grep -m 1 &quot;CURRENT_PROJECT_VERSION = &quot; &quot;$PROJECT_FILE&quot; | sed &apos;s/.*CURRENT_PROJECT_VERSION = \([^;]*\);.*/\1/&apos; | tr -d &apos; ;&apos;&#10;}&#10;&#10;# Set the build number in project.pbxproj&#10;set_build_number() {&#10;    local new_version=&quot;$1&quot;&#10;    # Use sed to replace all occurrences of CURRENT_PROJECT_VERSION&#10;    if [[ &quot;$OSTYPE&quot; == &quot;darwin&quot;* ]]; then&#10;        sed -i &apos;&apos; &quot;s/CURRENT_PROJECT_VERSION = [^;]*/CURRENT_PROJECT_VERSION = $new_version/&quot; &quot;$PROJECT_FILE&quot;&#10;    else&#10;        sed -i &quot;s/CURRENT_PROJECT_VERSION = [^;]*/CURRENT_PROJECT_VERSION = $new_version/&quot; &quot;$PROJECT_FILE&quot;&#10;    fi&#10;}&#10;&#10;# Get the last build number that was bumped for this commit&#10;get_last_bumped_build_number() {&#10;    git -C &quot;$PROJECT_DIR&quot; config --local &quot;build.lastBumpedNumber&quot; 2&gt;/dev/null || echo &quot;&quot;&#10;}&#10;&#10;# Store the build number as bumped for this commit&#10;set_last_bumped_build_number() {&#10;    local build_num=&quot;$1&quot;&#10;    git -C &quot;$PROJECT_DIR&quot; config --local &quot;build.lastBumpedNumber&quot; &quot;$build_num&quot;&#10;}&#10;&#10;# Get the git index state (hash of staged changes)&#10;get_index_state() {&#10;    git -C &quot;$PROJECT_DIR&quot; diff --cached --quiet 2&gt;/dev/null &amp;&amp; echo &quot;clean&quot; || echo &quot;dirty&quot;&#10;}&#10;&#10;CURRENT_BUILD=$(get_current_build_number)&#10;&#10;if [ -z &quot;$CURRENT_BUILD&quot; ]; then&#10;    echo &quot;&#x26a0;&#xfe0f;  Could not find CURRENT_PROJECT_VERSION in project.pbxproj. Skipping bump.&quot;&#10;    exit 0&#10;fi&#10;&#10;LAST_BUMPED=$(get_last_bumped_build_number)&#10;&#10;# If the build number was already bumped to this value in the current session, skip&#10;if [ &quot;$CURRENT_BUILD&quot; = &quot;$LAST_BUMPED&quot; ]; then&#10;    echo &quot;&#x2713; Build number $CURRENT_BUILD already bumped in this session. Skipping.&quot;&#10;    exit 0&#10;fi&#10;&#10;# Bump the build number&#10;NEW_BUILD=$((CURRENT_BUILD + 1))&#10;set_build_number &quot;$NEW_BUILD&quot;&#10;set_last_bumped_build_number &quot;$NEW_BUILD&quot;&#10;&#10;echo &quot;&#x2713; Build number bumped: $CURRENT_BUILD &#x2192; $NEW_BUILD&quot;&#10;&#10;# Stage the change if git is available&#10;if git -C &quot;$PROJECT_DIR&quot; rev-parse --is-inside-work-tree &gt; /dev/null 2&gt;&amp;1; then&#10;    git -C &quot;$PROJECT_DIR&quot; add &quot;$PROJECT_FILE&quot; 2&gt;/dev/null || true&#10;    echo &quot;&#x2713; Staged project file changes&quot;&#10;fi&#10;&#10;exit 0&#10;"
               shellToInvoke = "/bin/bash">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "AA8C50DA2FAB9A7000FC23FF"
                     BuildableName = "Today.app"
                     BlueprintName = "Today"
                     ReferencedContainer = "container:Today.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
